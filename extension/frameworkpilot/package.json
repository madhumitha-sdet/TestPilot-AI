{
  "name": "frameworkpilot",
  "displayName": "FrameworkPilot",
  "description": "AI-assisted SDET test automation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:frameworkpilot.configureAdo",
    "onCommand:frameworkpilot.openDashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "frameworkpilot.configureAdo",
        "title": "FrameworkPilot: Configure Azure DevOps"
      },
      {
        "command": "frameworkpilot.openDashboard",
        "title": "FrameworkPilot: Open FrameworkPilot"
      }
    ],
    "configuration": {
      "title": "FrameworkPilot",
      "properties": {
        "frameworkpilot.ado.organizationUrl": {
          "type": "string",
          "description": "Azure DevOps organization URL"
        },
        "frameworkpilot.ado.projectName": {
          "type": "string",
          "description": "Azure DevOps project name"
        },
        "frameworkpilot.ado.planId": {
          "type": "string",
          "description": "Azure DevOps Test Plan ID"
        },
        "frameworkpilot.ado.suiteId": {
          "type": "string",
          "description": "Azure DevOps Test Suite ID"
        },
        "frameworkpilot.framework.frameworkMode": {
          "type": "string",
          "description": "Whether FrameworkPilot uses an existing framework/project or creates a new one"
        },
        "frameworkpilot.framework.language": {
          "type": "string",
          "description": "Automation language"
        },
        "frameworkpilot.framework.automationTool": {
          "type": "string",
          "description": "Automation tool"
        },
        "frameworkpilot.framework.testRunner": {
          "type": "string",
          "description": "Test runner"
        },
        "frameworkpilot.framework.architecture": {
          "type": "string",
          "description": "Automation architecture"
        },
        "frameworkpilot.framework.testDataApproach": {
          "type": "string",
          "description": "Test data approach"
        },
        "frameworkpilot.framework.projectPath": {
          "type": "string",
          "description": "Path to the automation project"
        },
        "frameworkpilot.framework.testCaseFile": {
          "type": "string",
          "description": "Path to a test case file"
        },
        "frameworkpilot.framework.existingPomFile": {
          "type": "string",
          "description": "Path to an existing Page Object file"
        },
        "frameworkpilot.framework.existingTestFile": {
          "type": "string",
          "description": "Path to an existing test file"
        },
        "frameworkpilot.framework.testCaseExcelPath": {
          "type": "string",
          "description": "Path to an Excel workbook containing test cases (one sheet per test case)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5"
  }
}
